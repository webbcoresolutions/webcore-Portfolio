{
  "name": "webcore-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "logo": "node scripts/build-logo.mjs",
